# Egyszeri/egyszerű helyi telepítés esetén itt semmit nem szükséges beállítani.
# Leginkább akkor hasznos, ha egy gépen több változata is fut ugyan ennek a projektnek.
# Használatához az `--env-file` szükséges.
# Például használat a szerveren:
#   docker compose --env-file .env.staging \
#     -f docker/compose.yml -f docker/compose.staging.yml up -d


# Szét kell választani a docker containerket egyedi névvel:
PROJECT=miserend-dev

#MISEREND_IMAGE=localhost/miserend-staging:latest

# Valamit kapjanak egyedi portokat a külön konténerek:
#APP_PORT=
#MYSQL_PORT=
#ES_HTTP_PORT=
#ES_TCP_PORT=
#MAILCATCHER_SMTP_PORT=
#MAILCATCHER_WEB_PORT=

# SMTP (#610). Dev/test alatt üresen hagyható: ott a mailcatcher az alapértelmezés.
# Production-ben KÖTELEZŐ, különben nem megy ki egyetlen levél sem (a /health pirosan jelzi).
# A production compose ezeket a `docker/.env` fájlból olvassa (a compose.yml mellől).
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
# üres | tls | ssl
SMTP_SECURE=
