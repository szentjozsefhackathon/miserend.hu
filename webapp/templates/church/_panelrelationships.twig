{% if fullNetwork|length > 1 %}
<div class="panel panel-default">
    <div class="panel-heading">
        <strong>Egyházi kapcsolatok</strong>
    </div>
    <div class="panel-body">
        <ul class="church-relationships-tree" style="list-style: none; padding-left: 0; margin: 0;">
            {% for item in fullNetwork %}
            <li >
                {# L-alakú nyíl és behúzás #}
                {% if item.level > 0 %}
                    <span style="display: inline-block; width: {{ (item.level - 1) * 20 }}px;"></span>
                    <span style="display: inline-block; margin-right: 5px;">
                        {% if item.isLast %}
                            └─>
                        {% else %}
                            ├─>
                        {% endif %}
                    </span>
                {% endif %}
                
                {# A templom link és adatai #}
                {% if item.church['church:type'] %}
                    <span class="label label-default" style="margin-left: 5px;">{{ ('CHURCH_RANK.' ~ item.church['church:type'])|trans }}</span>
                {% endif %}

                {% if item.isCurrent %}
                    <strong class="current-church" style="background-color: #fff3cd; padding: 2px 6px; border-radius: 3px;">
                        <a href="/templom/{{ item.church.id }}">{{ item.church.names.0 }}</a>
                    </strong>
                {% else %}
                    <a href="/templom/{{ item.church.id }}">{{ item.church.names.0 }}</a>
                {% endif %}
                
                {# #496/#497/#498: a település az OSM-határokból; a `varos` oszlopot a #805 eldobja. #}
                {% set telepules = item.church.locationCityName() %}
                {% if telepules and telepules != city.name %}
                    <span style="color: #666;">({{ telepules }})</span>
                {% endif %}
                
                
            </li>
            {% endfor %}
        </ul>

        {#
            #506: átjáró a család közös miserendjéhez (borazslo kérése).

            A megnevezés a hálózat GYÖKERÉNEK a rangja — az mondja meg, mi ez az
            egész, nem az, ahol épp állunk. Ha nincs rögzítve, „plébánia": az a
            tipikus eset, és jobb, mint az „ismeretlen".

            A hivatkozás a MOSTANI templomra mutat, nem a gyökérre: a látogató ott
            marad, ahol van, csak a naptár bővül ki a rokon templomokéval.
        #}
        {% set gyoker = fullNetwork|first %}
        {% set rang = gyoker.church['church:type'] ? ('CHURCH_RANK.' ~ gyoker.church['church:type'])|trans : 'plébánia' %}
        <a href="/templom/{{ church.id }}?csalad=1" class="btn btn-default btn-block" style="margin-top: 10px;">
            A teljes {{ rang }} közös miserendje
        </a>
    </div>
</div>
{% endif %}
