calendar/node_modules
calendar/.angular
calendar/tmp
vendor
.git

# ignore node junks
**/.npm

# webapp dependencies and build artifacts
webapp/vendor/
webapp/node_modules/

# PHPUnit artifacts
webapp/tests/.phpunit.cache/
webapp/tests/.phpunit.result.cache
webapp/tests/coverage/

# Exclude user-uploaded photos (WSL2 permission issues)
webapp/kepek/templomok/

# allow Angular build output
!calendar/dist
!calendar/dist/**

# #750: adatbázis-felület soha ne kerüljön az image-be. A nézelődés az
# opt-in docker/compose.adminer.yml profillal megy (csak 127.0.0.1 + SSH-tunnel).
webapp/adminer.php
webapp/adminer*.php
