{# #661/#653: a Leafletet és a bővítményeit saját magunk szolgáljuk ki a
   webapp/package.json-ból, nem az unpkg-ról és nem egy GitHub Pages-ről.
   Így nincs két idegen hoszt a térképes oldalak kritikus útján, és nem
   tölthetünk be háromféle Leaflet-verziót három sablonból (itt 1.7.1 volt,
   a stat.twig-ben 1.9.3, a church/create.twig-ben 1.9.4). Egységesen 1.9.4. #}
<link rel="stylesheet" href="/node_modules/leaflet/dist/leaflet.css"/>
<script src="/node_modules/leaflet/dist/leaflet.js"></script>
<script src="/node_modules/leaflet-textpath/leaflet.textpath.js"></script>
<script src="/node_modules/leaflet-polylinedecorator/dist/leaflet.polylineDecorator.js"></script>

<style>
    /* Map Popup Weekend Masses Styling */
    .map-popup-container {
        padding: 10px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-width: 200px;
    }

    .map-popup-container h3 {
        margin: 0 0 8px 0;
        font-size: 14px;
        font-weight: 600;
        color: #1f2937;
    }

    .map-popup-container h3 a {
        color: #1e40af;
        text-decoration: none;
    }

    .map-popup-container h3 a:hover {
        text-decoration: underline;
    }

    .popup-thumbnail {
        display: block;
        max-width: 200px;
        max-height: 150px;
        width: 100%;
        border-radius: 4px;
        margin-bottom: 8px;
        object-fit: cover;
    }

    .weekend-masses {
        margin-top: 10px;
    }

    .mass-day {
        margin: 8px 0;
    }

    .day-label {
        display: block;
        font-weight: 600;
        font-size: 12px;
        margin-bottom: 4px;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .mass-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .mass-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 500;
        color: #fff;
        white-space: nowrap;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .mass-badge.saturday {
        background-color: #7C3AED; /* Szombat: lila */
    }

    .mass-badge.saturday:hover {
        background-color: #6D28D9;
    }

    .mass-badge.sunday {
        background-color: #DC2626; /* Vasárnap: piros */
    }

    .mass-badge.sunday:hover {
        background-color: #B91C1C;
    }
</style>

<div id="mapid" ></div>


<script>
    /*
     * #653: az oldalanként változó adat — ez az EGYETLEN, ami a HTML-be kerül.
     * A térkép logikája a cache-elhető /js/church-map.js-ben van (~67 KB), amit így a
     * böngésző templomoldalanként nem tölt le újra.
     */
    window.miserendMapConfig = {
        churchId: {% if church_id %}{{ church_id }}{% else %}null{% endif %},
        boundary: {% if boundary %}{{ boundary|json_encode|raw }}{% else %}null{% endif %},
        center: {% if center %}{ lat: {{ center.lat }}, lon: {{ center.lon }}, zoom: {{ center.zoom|default('null') }} }{% else %}null{% endif %},
        location: {% if location %}{ lat: {{ location.lat }}, lon: {{ location.lon }}, zoom: {{ location.zoom|default('null') }} }{% else %}null{% endif %},
        dioceses: {% if dioceseslayer %}true{% else %}false{% endif %},
        autoGeoLocation: {% if enableAutoGeoLocation is defined and enableAutoGeoLocation %}true{% else %}false{% endif %}
    };
</script>
<script src="/js/church-map.js"></script>
