{% set columns2 = true  %}

{% extends "layout.twig" %}



{% block extraHead %}
    <script src="/js/unified-autocomplete.js"></script>
    {% if nearbyOrigin %}
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    {% endif %}
    <script>
        window.boundaryDataFromUrl = {{ boundaryDataJson|raw|default('[]') }};
        window.churchDataFromUrl = {{ churchDataJson|raw|default('[]') }};
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof UnifiedAutocomplete !== 'undefined') {
                UnifiedAutocomplete.init('#keyword', '#panel-search-mass-form', {
                    initialBoundaries: window.boundaryDataFromUrl || [],
                    initialChurches: window.churchDataFromUrl || []
                });
            }
        });
    </script>
    <style>
        /* #515: régi-adat jelzés a találati listában (mint a templomoldalon) */
        .mass-results-table tr.mass-row--stale td { text-decoration: line-through; opacity: .55; }
        .mass-row-freshness { margin-left: 6px; cursor: help; }
        .mass-row-freshness--stale { color: #b02a37; }
        .mass-row-freshness--medium { color: #997404; }
        #nearby-masses-map { height: 420px; margin: 0 0 18px; border-radius: 4px; }
        #nearby-church-card {
            margin: -6px 0 18px;
            padding: 14px 16px;
            border-left: 4px solid #6f3b8f;
            background: #f7f3f9;
        }
        .nearby-church-card-hint { margin: 0; color: #555; }
        /* #608: a bejelentő kérése — háttér nélküli, pici betűs, csak időpontot mutató gombostű. */
        .leaflet-tooltip.nearby-time-label {
            background: none;
            border: none;
            box-shadow: none;
            padding: 0;
            font-size: 11px;
            font-weight: 700;
            line-height: 1;
            color: #3b1a4d;
            /* A térkép bármilyen színű lehet alatta, ezért fehér kontúr adja az olvashatóságot. */
            text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 0 3px #fff;
            white-space: nowrap;
        }
        .leaflet-tooltip.nearby-time-label::before { display: none; }
        .mass-empty-state {
            margin: 8px 0 18px;
            padding: 16px 18px;
            border-left: 4px solid #6f3b8f;
            background: #f7f3f9;
        }
        .mass-empty-state p { margin: 0 0 8px; }
        .mass-empty-state-title { font-weight: 700; }
        .mass-empty-state-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .nearby-church-card-times { margin: 8px 0; display: flex; flex-wrap: wrap; gap: 10px; }
        .nearby-list-time { color: #333; font-weight: 700; white-space: nowrap; }
        .mass-results-table tr.nearby-church-selected td {
            background: #f7f3f9;
            box-shadow: inset 0 1px #dacbe2, inset 0 -1px #dacbe2;
        }
    </style>
{% endblock %}


{% block pageHeader %}
    <div class="page-header">
        <h1>{{ title|raw }}</h1>
    </div>
    {% include 'announcment.twig' ignore missing %}
{%  endblock %}

{% block content %}

    {{ alert|raw }}
    {{ tartalom|raw }}
    <strong><span class=kiscim>Keresési paraméterek:</span></strong><br/>
    {% if filters is defined and filters|length %}
        {% for filter in filters %}
            <span class="alap"><img src="/img/negyzet_lila.gif" align="absmiddle"> {{ filter|raw }}</span><br/>
        {% endfor %}
    {% else %}
        <span class="alap">Nincsenek szűrők</span><
    {% endif %}
    <br/>

    {% if results %}

            {% if nearbyOrigin %}
                <div id="nearby-masses-map" aria-label="Közeli misék térképe"></div>
                <section id="nearby-church-card" aria-live="polite">
                    <p class="nearby-church-card-hint">Válassz egy templomot a térképen a miseidőpontjai megtekintéséhez. Az alábbi lista minden találatot mutat.</p>
                </section>
                <script>
                document.addEventListener('DOMContentLoaded', function () {
                    if (typeof L === 'undefined') return;
                    var origin = {{ nearbyOrigin|json_encode|raw }};
                    var radiusKm = {{ nearbyRadius|json_encode|raw }};
                    var churches = {{ nearbyMapJson|raw }};
                    var map = L.map('nearby-masses-map').setView([origin.lat, origin.lon], 12);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap közreműködők'
                    }).addTo(map);
                    var bounds = L.latLngBounds([[origin.lat, origin.lon]]);
                    function escapeHtml(value) {
                        var node = document.createElement('div');
                        node.textContent = value == null ? '' : String(value);
                        return node.innerHTML;
                    }
                    L.circle([origin.lat, origin.lon], { radius: radiusKm * 1000, color: '#5a2583', fillOpacity: 0.04 }).addTo(map);
                    L.circleMarker([origin.lat, origin.lon], { radius: 6, color: '#135e96', fillOpacity: 1 })
                        .bindTooltip('Kiindulópont').addTo(map);
                    function selectChurch(church) {
                        document.querySelectorAll('.mass-result-row').forEach(function (row) {
                            row.classList.toggle('nearby-church-selected', Number(row.dataset.churchId) === Number(church.id));
                        });
                        var times = Array.from(new Set(church.times));
                        var card = document.getElementById('nearby-church-card');
                        card.innerHTML = '<strong>' + escapeHtml(church.name) + '</strong>'
                            + '<div>' + escapeHtml(church.city) + ' · ' + church.distance_km + ' km légvonalban</div>'
                            + '<div class="nearby-church-card-times">'
                            + times.map(function (time) { return '<span class="nearby-list-time">' + time + '</span>'; }).join('')
                            + '</div><a class="btn btn-sm btn-primary" href="/templom/' + church.id + '">Templom adatlapja</a>';
                    }
                    churches.forEach(function (church) {
                        var marker = L.circleMarker([church.lat, church.lon], {
                            radius: 7,
                            color: '#fff',
                            weight: 2,
                            fillColor: '#6f3b8f',
                            fillOpacity: 1
                        });
                        // #608: a gombostű felirata háttér nélküli, pici betűs, és csak az
                        // időpontot tartalmazza — a fehér tooltip-téglalap takarta a térképet.
                        if (church.times.length) marker.bindTooltip(church.times[0], {
                            permanent: true,
                            direction: 'top',
                            offset: [0, -6],
                            opacity: 1,
                            className: 'nearby-time-label'
                        });
                        marker.on('click', function () { selectChurch(church); });
                        marker.addTo(map);
                        bounds.extend([church.lat, church.lon]);
                    });
                    if (churches.length) map.fitBounds(bounds.pad(0.15));
                });
                </script>
            {% endif %}

            <div class="row" style="margin-bottom:12px">
                <p>
                Listázott találatok: <strong>{{ (pagination.active * pagination.take) + 1 }} - 
                {% if pagination.resultsCount < ( pagination.active + 1 ) * pagination.take %}
                    {{ pagination.resultsCount }}
                {% else %}
                    {{ ( pagination.active + 1 ) * pagination.take }} 
                {% endif %}</strong>
                (Összesen: <strong>{{ pagination.resultsCount }}</strong>)
                </p>
            </div>

            <table class="table mass-results-table">
                <tbody>
                {% set previousDate = null %}
                {% set rowCounter = 0 %}
                {% for result in results %}
                    {% set church = result.church %}
                    {# #515: régi-adat jelzés a templom frissítettsége alapján (mint a templomoldalon: 180 nap / 1825 nap) #}
                    {% set freshTs = (church.frissites and church.frissites != '0000-00-00') ? church.frissites|date('U') : null %}
                    {% set daysAgo = freshTs ? (("now"|date('U')) - freshTs) / 86400 : null %}
                    {% set currentDate = result.start_date|date('Y-m-d') %}
                    {% if previousDate is null or previousDate != currentDate %}
                        <tr class="date-header">
                            <td colspan="{{ nearbyOrigin ? 6 : 5 }}">
                                <span class="date-header-text">
                                    <span>{{ result.start_date|miserend_date('') }}</span>
                                    {% if liturgicalDays[currentDate].name %}
                                        <span class="date-header-liturgy">{{ liturgicalDays[currentDate].name }}</span>
                                    {% endif %}
                                </span>
                            </td>
                        </tr>
                        {% set previousDate = currentDate %}
                        {% set rowCounter = 0 %}
                    {% endif %}
                    {% set rowClasses = [] %}
                    {% if rowCounter % 2 == 1 %}{% set rowClasses = rowClasses|merge(['table-light']) %}{% endif %}
                    {% if daysAgo is not null and daysAgo >= 1825 %}{% set rowClasses = rowClasses|merge(['mass-row--stale']) %}{% endif %}
                    <tr class="mass-result-row{% if rowClasses|length %} {{ rowClasses|join(' ') }}{% endif %}" data-church-id="{{ church.id }}">
                        <td class="align-middle">
                            {% if nearbyOrigin %}
                                <span class="nearby-list-time">{{ "%02d:%02d"|format((result.start_minutes / 60)|round(0, 'floor'), (result.start_minutes % 60)) }}</span>
                            {% else %}
                                <span class="badge badge-primary">{{ "%02d:%02d"|format((result.start_minutes / 60)|round(0, 'floor'), (result.start_minutes % 60)) }}</span>
                            {% endif %}
                        </td>

                        <td class="align-middle">
                            <img src="/cal_images/types/{{ result.rite|lower }}.svg" alt="{{ result.rite|trans }}" title="{{ result.rite|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                            <strong class="mass-list-title">{{ result.title }}</strong>
                        </td>

                        <td class="align-middle">
                            {# #334: a mise nyelve lista is lehet (szlovák-latin), ilyenkor
                               mindegyikhez kiteszünk egy zászlót. A magyart továbbra sem
                               jelöljük külön — egynyelvű magyar misénél az lenne a zaj. #}
                            {% set massLangs = result.lang is iterable ? result.lang : (result.lang ? [result.lang] : []) %}
                            {% if massLangs != ['hu'] %}
                                {% for lang in massLangs %}
                                    <img src="/cal_images/flags/{{ lang|lower }}.svg" alt="{{ ('LANGUAGES.' ~ lang)|trans }}" title="{{ ('LANGUAGES.' ~ lang)|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                                {% endfor %}
                            {% endif %}
                            {% if result.types is iterable and result.types|length %}
                                {% for type in result.types %}
                                    <img src="/cal_images/types/{{ type|lower }}.png" alt="{{ type|trans }}" title="{{ type|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
                                {% endfor %}
                            {% endif %}
                            {% if result.comment %}
                                <i class='fas fa-info-circle' style='font-size:medium' title='{{ result.comment|striptags }}'></i>
                            {% endif %}
                        </td>

                        <td class="align-middle">
                            <a href='/templom/{{ church.id }}' class=felsomenulink title='{{ church.names|slice(1)|join(', ') }}'>
                                <b>{{ church.names.0 }}</b>
                                <span class="church-result-city">
                                    {% if church.varos is iterable %}
                                        ({{ church.varos.0 }})
                                    {% else %}
                                        ({{ church.varos }})
                                    {% endif %}
                                </span>
                            </a>
                            {% if church.alternative_names.0 %}
                                <br/><span class="alap" style="margin-left: 20px; font-style: italic;" title="{{ church.alternative_names|slice(1)|join(', ') }}">{{ church.alternative_names.0 }}</span>
                            {% endif %}
                            {% if daysAgo is not null and daysAgo >= 1825 %}
                                <i class="fas fa-exclamation-triangle mass-row-freshness mass-row-freshness--stale" title="Az adatok több mint 5 éve nem lettek frissítve – szinte biztosan megbízhatatlanok. Segíts: a templom oldalán szerkeszd a naptárat, vagy küldj észrevételt!"></i>
                            {% elseif daysAgo is not null and daysAgo >= 180 %}
                                <i class="fas fa-exclamation-circle mass-row-freshness mass-row-freshness--medium" title="Az adatok egy ideje nem lettek megerősítve. Segíts: a templom oldalán szerkeszd a naptárat, vagy küldj észrevételt!"></i>
                            {% endif %}
                        </td>
                        <td class="align-middle">
                            {% if result.period or result.mass.rrule %}
                                <span class="badge" style="background-color:{{ result.period.color ?? '' }}" title="{{ result.mass.rrule.readable }}">{{ result.period.name ?? 'Időszak nélkül' }}</span>
                            {% endif %}
                        </td>
                        {% if nearbyOrigin %}
                            <td class="align-middle text-nowrap mass-distance" data-distance="{{ result.distance_km }}"><strong>{{ result.distance_km|number_format(2, ',', ' ') }} km</strong></td>
                        {% endif %}
                    </tr>
                    {% set rowCounter = rowCounter + 1 %}
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            {# #608: a szűk időablak (pl. „következő két óra") gyakran üres — ne néma üres oldal fogadjon. #}
            <div class="mass-empty-state">
                {% if nearbyOrigin %}
                    <p class="mass-empty-state-title">A megadott {{ nearbyRadius }} km-es körben ebben az időszakban nincs mise.</p>
                    {% if nearbyNextMass %}
                        <p>
                            A legközelebbi mise a közelben:
                            <a href="/templom/{{ nearbyNextMass.church_id }}"><strong>{{ nearbyNextMass.church_name }}</strong></a>
                            {% if nearbyNextMass.church_city %}({{ nearbyNextMass.church_city }}){% endif %}
                            — <strong>{{ nearbyNextMass.start_date|miserend_date }}</strong>
                            {%- if nearbyNextMass.distance_km is not null -%}
                                , {{ nearbyNextMass.distance_km|number_format(2, ',', ' ') }} km légvonalban
                            {%- endif -%}
                        </p>
                        <a class="btn btn-sm btn-primary" href="{{ nearbyLookaheadUrl }}">
                            A következő {{ nearbyLookaheadDays }} nap miséi itt ({{ nearbyNextMass.total }} találat)
                        </a>
                    {% else %}
                        <p>A következő {{ nearbyLookaheadDays }} napban sincs mise ebben a körben. Próbáld nagyobb sugárral:</p>
                        <p class="mass-empty-state-actions">
                            {% for radius, url in nearbyWiderRadiusUrls %}
                                <a class="btn btn-sm btn-outline-primary" href="{{ url }}">{{ radius }} km</a>
                            {% endfor %}
                        </p>
                    {% endif %}
                {% else %}
                    <p class="mass-empty-state-title">A megadott feltételekkel nem találtunk eseményt.</p>
                    <p>Próbáld tágabb időszakkal, kevesebb szűrővel vagy más kulcsszóval.</p>
                {% endif %}
            </div>
        {% endif %}

        {% include '_pagination.twig' %}


{% endblock %}

{% block leftsidebar %}
    {% include "_panelsearchmass.twig" %}
{% endblock %}
