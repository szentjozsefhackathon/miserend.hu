{% set title = 'Facebook' %}

{% block body %}     

	{% set facebookLinkExists = false %}
	{% for link in links %}
		{% if link.type == 'facebook' %}
			{% set facebookLinkExists = true %}
		{% endif %}
	{% endfor %}

	{% if facebookLinkExists  %}

		<div class="panel-group hidden-xs" id="accordion">
		<div class="panel panel-default" {% if id %}id="{{id}}"{% endif %}>
		
		{# A Facebook SDK-t a lap ELKÉSZÜLTE UTÁN töltjük be.
		   Sablonba írt <script async>-ként a böngésző a `load` eseményt addig halasztja,
		   amíg a connect.facebook.net válaszol — vagyis a templomoldal elkészülte egy
		   idegen hoszton múlt. Élesben ettől „töltődik" a lap, a böngészős teszteknél
		   pedig ez időtúllépésig tartó beakadás. Betöltés után injektálva a plugin
		   ugyanúgy megjelenik, csak nem tartja vissza az oldalt. #}
		<div id="fb-root"></div>
		<script>
			window.addEventListener('load', function () {
				if (document.getElementById('facebook-jssdk')) { return; }
				var sdk = document.createElement('script');
				sdk.id = 'facebook-jssdk';
				sdk.async = true;
				sdk.defer = true;
				sdk.crossOrigin = 'anonymous';
				sdk.nonce = 'LHJX0sYO';
				sdk.src = 'https://connect.facebook.net/hu_HU/sdk.js#xfbml=1&version=v14.0&appId=259925661728758&autoLogAppEvents=1';
				document.body.appendChild(sdk);
			});
		</script>
		
		{% for key, link in links %}

			{% if link.type == 'facebook' %}
						
				<div 
					class="fb-page" 
					data-href="{{link.href}}" 
					data-tabs="timeline" 
					data-width="" 
					data-height="" 
					data-small-header="true" 
					data-adapt-container-width="true" 
					data-hide-cover="false" 
					data-show-facepile="false"
					>
					
					<blockquote cite="{{link.href}}" class="fb-xfbml-parse-ignore">
						<a href="{{link.href}}/">{{link.title}}</a>
					</blockquote>
				</div>
							
			{% endif %}
		

		
		{% endfor %}
		</div>
		</div>
	
    {% endif %}

{%  endblock %}