{% import "forms.twig" as forms %}
{% import 'macros/icons.twig' as icons %}

{% extends "layout.twig" %}

{% set pageTitle = 'Miserend' %}

{% set columns2 = true  %}		


{# Macro to render a type-toggle button. Usage: {{ macros.type_button('FAMILY', 'Family') }} #}
{% macro type_button(type, special=false) %}
    <button type="button" class="btn btn-outline-secondary type-toggle{% if special %} special-toggle{% endif %}" data-type="{{ type }}" data-state="0"{% if special %} data-special="true"{% endif %}>
        {% if not special %}
            <img src="/cal_images/types/{{ type|lower }}.png" title="{{ type|trans }}" alt="{{ type|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
        {% else %}            
            <img src="/cal_images/types/{{ type|lower }}.svg" title="{{ type|trans }}" alt="{{ type|trans }}" style="height:1.3em; margin-right:6px; vertical-align:middle;">
            {{ type|trans }}
        {% endif %}            
            
    </button>
{% endmacro %}

{% import _self as macros %}

{% block extraHead %}
    <style>
        .block:after{
            clear: both;
            content: "";
            display: block;
        }
        
        /* Make buttons fit their content width */
        #start_date_btn,
        #end_date_btn,
        #start_time_btn,
        #end_time_btn {
            width: auto;
            flex: 0 0 auto;
            white-space: nowrap;
        }
        
        /* Keep date-time pairs visually connected */
        #start_time_btn,
        #end_time_btn {
            margin-left: -1px;
        }
    </style>
    <link rel="stylesheet" href="/node_modules/clockpicker/dist/jquery-clockpicker.css">
    <script src="/node_modules/clockpicker/dist/jquery-clockpicker.js"></script>
    <script src="/js/unified-autocomplete.js"></script>
    
{% endblock %}

{% block pageHeader %}
    <div class="page-header">
        <h1>Miserend<small><span class="hidden-xs"> és templom keresés</span></small></h1>
    </div>
{%  endblock %}



{% block content %}
    {% include 'announcment.twig' ignore missing %}
    
    {{ alert|raw }}

    {% include '_panelcampaign.twig' with { collapsible: 'collapsed' }  %}    

    <div class="miseurlap">
        <form method=get action="index.php" name="kereses" id="kereses" class="form-group">

	    <div class="d-flex justify-content-center">
        </div>

            <div id="form_church"  style="margin-top:12px;">
                <div class="search-field-group">
                    <label class="search-label">Templom</label>
                    <div class="search-input-wrap">{{ forms.input(searchform.kulcsszo) }}</div>                    
                </div>
            </div>

            <div id="form_mass_details" style="">
                {# Mise date/time picker section #}
                <div class="form-group row">
                    <label class="col-sm-4 control-label">Mise</label>
                    <div class="col-sm-8">
                        <div class="btn-group" role="group" aria-label="Mass date/time filters" id="mass_datetime_group">
                            <button type="button" class="btn btn-success mass-date-btn" id="start_date_btn" data-type="start_date">
                                <span id="start_date_display">YYYY.mm.dd</span>
                            </button>
                            <button type="button" class="btn btn-success mass-time-btn" id="start_time_btn" data-type="start_time">
                                <span id="start_time_display">hh:ii</span>
                            </button>
                            <button type="button" class="btn btn-light" disabled style="cursor: default;">-</button>
                            <button type="button" class="btn btn-success mass-date-btn" id="end_date_btn" data-type="end_date">
                                <span id="end_date_display">YYYY.mm.dd</span>
                            </button>
                            <button type="button" class="btn btn-success mass-time-btn" id="end_time_btn" data-type="end_time">
                                <span id="end_time_display">hh:ii</span>
                            </button>
                        </div>
                    </div>
                </div>
                        <input type="hidden" name="start_date" id="start_date" value="">
                        <input type="hidden" name="start_time" id="start_time" value="">
                        <input type="hidden" name="end_date" id="end_date" value="">
                        <input type="hidden" name="end_time" id="end_time" value="">
                        
                        {# Hidden clockpicker inputs #}
                        <input type="text" id="clockpicker_start_time" class="clockpicker" style="display:none;">
                        <input type="text" id="clockpicker_end_time" class="clockpicker" style="display:none;">

                <script>
                    (function($){
                        // Get URL parameters
                        function getUrlParameter(name) {
                            var url = window.location.href;
                            var regex = new RegExp('[?&]' + name + '=([^&#]*)');
                            var results = regex.exec(url);
                            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
                        }

                        // Initialize date/time values from URL parameters or defaults
                        function initializeMassDateTime() {
                            var now = new Date();
                            var startDate, startTime, endDate, endTime;

                            // Try to get values from URL parameters
                            var urlStartDate = getUrlParameter('start_date');
                            var urlStartTime = getUrlParameter('start_time');
                            var urlEndDate = getUrlParameter('end_date');
                            var urlEndTime = getUrlParameter('end_time');

                            if (urlStartDate) {
                                startDate = urlStartDate;
                            } else {
                                startDate = formatDate(now);
                            }

                            if (urlStartTime) {
                                startTime = urlStartTime;
                            } else {
                                // Default: now - 1 hour
                                startTime = formatTime(addMinutes(now, -60));
                            }

                            if (urlEndDate) {
                                endDate = urlEndDate;
                            } else {
                                // Default: today + 3 days
                                var endDateObj = addMinutes(now, 3 * 24 * 60);
                                endDate = formatDate(endDateObj);
                            }

                            if (urlEndTime) {
                                endTime = urlEndTime;
                            } else {
                                // Default: current time
                                endTime = formatTime(now);
                            }

                            $('#start_date').val(startDate);
                            $('#start_time').val(startTime);
                            $('#end_date').val(endDate);
                            $('#end_time').val(endTime);

                            updateDisplays();
                        }

                        function formatDate(date) {
                            var year = date.getFullYear();
                            var month = String(date.getMonth() + 1).padStart(2, '0');
                            var day = String(date.getDate()).padStart(2, '0');
                            return year + '-' + month + '-' + day;
                        }

                        function formatTime(date) {
                            var hours = String(date.getHours()).padStart(2, '0');
                            var minutes = String(date.getMinutes()).padStart(2, '0');
                            return hours + ':' + minutes;
                        }

                        function formatDateDisplay(dateStr) {
                            if (!dateStr) return 'YYYY.mm.dd';
                            var parts = dateStr.split('-');
                            if (parts.length !== 3) return dateStr;
                            
                            // Parse the selected date
                            var selectedDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                            
                            // Get today's date (normalized to midnight)
                            var today = new Date();
                            today.setHours(0, 0, 0, 0);
                            
                            // Calculate difference in days
                            var timeDiff = selectedDate.getTime() - today.getTime();
                            var dayDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
                            
                            // Day names in Hungarian
                            var dayNames = ['vasárnap', 'hétfő', 'kedd', 'szerda', 'csütörtök', 'péntek', 'szombat'];
                            
                            // Check if it's today
                            if (dayDiff === 0) {
                                return 'ma';
                            }
                            
                            // Check if it's tomorrow
                            if (dayDiff === 1) {
                                return 'holnap';
                            }
                            
                            // Check if it's within 3 days from today (and not today or tomorrow)
                            if (dayDiff > 1 && dayDiff < 4) {
                                var dayName = dayNames[selectedDate.getDay()];
                                return dayName;
                            }
                            
                            // Otherwise show the date - include year only if it differs from current year
                            var currentYear = today.getFullYear();
                            var selectedYear = parseInt(parts[0]);
                            if (selectedYear !== currentYear) {
                                return parts[0] + '.' + parts[1] + '.' + parts[2] + '.';
                            } else {
                                return parts[1] + '.' + parts[2] + '.';
                            }
                        }

                        function formatTimeDisplay(timeStr) {
                            return timeStr || 'hh:ii';
                        }

                        function addMinutes(date, minutes) {
                            return new Date(date.getTime() + minutes * 60000);
                        }

                        function parseDateTime(dateStr, timeStr) {
                            if (!dateStr || !timeStr) return null;
                            var parts = dateStr.split('-');
                            var timeParts = timeStr.split(':');
                            if (parts.length === 3 && timeParts.length === 2) {
                                return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), parseInt(timeParts[0]), parseInt(timeParts[1]));
                            }
                            return null;
                        }

                        function updateDisplays() {
                            var startDate = $('#start_date').val();
                            var startTime = $('#start_time').val();
                            var endDate = $('#end_date').val();
                            var endTime = $('#end_time').val();

                            $('#start_date_display').text(formatDateDisplay(startDate));
                            $('#start_time_display').text(formatTimeDisplay(startTime));
                            $('#end_date_display').text(formatDateDisplay(endDate));
                            $('#end_time_display').text(formatTimeDisplay(endTime));
                        }

                        function validateAndAdjustTimes() {
                             var startDate = $('#start_date').val();
                             var startTime = $('#start_time').val();
                             var endDate = $('#end_date').val();
                             var endTime = $('#end_time').val();

                             var startDt = parseDateTime(startDate, startTime);
                             var endDt = parseDateTime(endDate, endTime);

                             if (!startDt || !endDt) return;

                             // If start date is later than end date, adjust end date to match start date
                             if (startDate > endDate) {
                                 $('#end_date').val(startDate);
                                 endDate = startDate;
                                 endDt = parseDateTime(endDate, endTime);
                             }

                             // If start date-time is later than end date-time, adjust end time
                             if (startDt > endDt) {
                                 var newEndTime = addMinutes(startDt, 10);
                                 if (newEndTime.getDate() !== startDt.getDate() || newEndTime.getHours() >= 23) {
                                     // If it goes beyond today or too late, set to 23:59
                                     $('#end_time').val('23:59');
                                 } else {
                                     $('#end_time').val(formatTime(newEndTime));
                                 }
                             }

                             updateDisplays();
                         }

                        $(function(){
                            // Initialize with current date/time
                            initializeMassDateTime();

                            // Date picker button handler
                            $(document).on('click', '.mass-date-btn', function(e){
                                e.preventDefault();
                                var $btn = $(this);
                                var type = $btn.data('type'); // 'start_date' or 'end_date'
                                var currentVal = $('#mass_' + type).val();

                                // Create a simple date picker dialog using jQuery UI datepicker
                                var $dialog = $('<div><input type="text" id="temp_datepicker" class="datepicker-temp"></div>');
                                $dialog.dialog({
                                    title: type === 'start_date' ? 'Kezdő dátum' : 'Vég dátum',
                                    modal: true,
                                    buttons: [],
                                    close: function() {
                                        $(this).dialog('destroy');
                                    }
                                });

                                $('#temp_datepicker').datepicker({
                                    regional: 'hu',
                                    dateFormat: "yy-mm-dd",
                                    defaultDate: currentVal || new Date(),
                                    onSelect: function(dateText) {
                                        $('#' + type).val(dateText);
                                        // Auto-set time when date is selected
                                        if (type === 'start_date') {
                                            $('#start_time').val('00:00');
                                        } else if (type === 'end_date') {
                                            $('#end_time').val('23:59');
                                        }
                                        validateAndAdjustTimes();
                                        updateDisplays();
                                        $dialog.dialog('close');
                                    }
                                }).datepicker('setDate', currentVal || new Date());

                                $('#temp_datepicker').focus();
                            });

                            // Time picker button handler with clockpicker and manual fallback
                            $(document).on('click', '.mass-time-btn', function(e){
                                e.preventDefault();
                                var $btn = $(this);
                                var type = $btn.data('type'); // 'start_time' or 'end_time'
                                var currentVal = $('#' + type).val();
                                
                                // Create a completely new input element for this dialog
                                var uniqueId = 'temp_clock_' + type + '_' + new Date().getTime();
                                
                                var $input = $('<input type="text" id="' + uniqueId + '" class="form-control" placeholder="HH:mm" style="font-size: 20px; padding: 12px; text-align: center; width: 120px; margin: 20px auto; display: block;">');
                                if (currentVal) {
                                    $input.val(currentVal);
                                }
                                
                                var $helpText = $('<div style="font-size: 12px; color: #666; margin-top: 10px; text-align: center;">Formátum: HH:mm (pl. 14:30)</div>');
                                var $wrapper = $('<div style="padding: 20px; text-align: center;"></div>').append($input).append($helpText);
                                
                                var originalVal = currentVal;
                                var clockpickerInitialized = false;
                                
                                // Function to validate time format
                                function validateTimeFormat(timeStr) {
                                    if (!timeStr) return false;
                                    var timePattern = /^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/;
                                    return timePattern.test(timeStr);
                                }
                                
                                // Function to save the time
                                function saveTime() {
                                    var newVal = $input.val();
                                    if (newVal && newVal !== originalVal && validateTimeFormat(newVal)) {
                                        $('#' + type).val(newVal);
                                        validateAndAdjustTimes();
                                        // Close the dialog after a short delay
                                        setTimeout(function() {
                                            $wrapper.dialog('close');
                                        }, 300);
                                    }
                                }
                                
                                $wrapper.dialog({
                                    title: type === 'start_time' ? 'Kezdő idő' : 'Vég idő',
                                    modal: true,
                                    width: 380,
                                    buttons: [
                                        {
                                            text: 'OK',
                                            click: function() {
                                                saveTime();
                                            }
                                        },
                                        {
                                            text: 'Mégse',
                                            click: function() {
                                                $(this).dialog('close');
                                            }
                                        }
                                    ],
                                    open: function() {
                                        var $input = $('#' + uniqueId);
                                        
                                        // Make sure any previous clockpicker instance is removed
                                        try {
                                            if ($input.data('clockpicker')) {
                                                $input.clockpicker('remove');
                                            }
                                        } catch(e) {}
                                        
                                        // Try to initialize clockpicker
                                        try {
                                            if (typeof $input.clockpicker === 'function') {
                                                $input.clockpicker({
                                                    placement: 'bottom',
                                                    align: 'left',
                                                    autoclose: true,
                                                    twelvehour: false
                                                });
                                                clockpickerInitialized = true;
                                                
                                                // Listen for change event to save and close dialog
                                                $input.off('change').on('change', function() {
                                                    saveTime();
                                                });
                                                
                                                // Show the picker
                                                setTimeout(function() {
                                                    try {
                                                        $input.click();
                                                    } catch(e) {
                                                        console.log('Error clicking input:', e);
                                                    }
                                                }, 100);
                                            } else {
                                                throw new Error('Clockpicker not available');
                                            }
                                        } catch(e) {
                                            console.log('Clockpicker initialization failed, using manual input:', e);
                                            clockpickerInitialized = false;
                                            $helpText.html('Az óraszerkesztő nem elérhető. Kérem, adja meg az időt HH:mm formátumban (pl. 14:30)').css('color', '#d9534f').css('margin-top', '15px');
                                            $input.focus();
                                        }
                                        
                                        // Add input validation for manual entry
                                        $input.off('blur').on('blur', function() {
                                            var val = $(this).val();
                                            if (val && !validateTimeFormat(val)) {
                                                $(this).css('border-color', '#d9534f').css('background-color', '#fdf7f7');
                                                $helpText.css('color', '#d9534f').text('Érvénytelen formátum! Kérem, HH:mm formátumban adja meg (pl. 14:30)');
                                            } else {
                                                $(this).css('border-color', '').css('background-color', '');
                                                $helpText.css('color', '#666').text('Formátum: HH:mm (pl. 14:30)');
                                            }
                                        });
                                        
                                        // Allow Enter key to submit
                                        $input.off('keypress').on('keypress', function(e) {
                                            if (e.which === 13) {
                                                e.preventDefault();
                                                saveTime();
                                                return false;
                                            }
                                        });
                                    },
                                    close: function() {
                                        var $input = $('#' + uniqueId);
                                        try {
                                            if (clockpickerInitialized && $input.data('clockpicker')) {
                                                $input.clockpicker('remove');
                                            }
                                        } catch(e) {
                                            console.log('Error removing clockpicker:', e);
                                        }
                                        $wrapper.dialog('destroy');
                                        $wrapper.remove();
                                    }
                                });
                            });
                        });
                    })(jQuery);
                </script>

                <div class="form-group row">
                    <label class="col-sm-4 control-label" >Nyelvek</label>
                    <div class="col-sm-8">
                        <div class="btn-group" role="group" aria-label="Language filters" id="language_group">
                            {% for lang in langs %}
                                <button type="button" class="btn btn-light lang-toggle" data-lang="{{ lang }}" data-state="0" style="padding:4px">
                                    <img src="/cal_images/flags/{{ lang|lower }}.svg" alt="{{ ('LANGUAGES.' ~ lang)|trans }}" title="{{ ('LANGUAGES.' ~ lang)|trans }}" style="height:1.3em; margin-right:0px; vertical-align:middle;">
                                </button>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="lang[should]" id="lang_should" value="">
                        <input type="hidden" name="lang[must_not]" id="lang_must_not" value="">
                    </div>
                </div>

                <script>
                    (function($){
                        function updateLanguageHiddenInputs() {
                            var shouldArr = [];
                            var shouldNotArr = [];
                            $('.lang-toggle').each(function(){
                                var state = Number($(this).data('state')) || 0;
                                var lang = $(this).data('lang');
                                if (state === 1) shouldArr.push(lang);
                                else if (state === -1) shouldNotArr.push(lang);
                            });
                            $('#lang_should').val(shouldArr.join(','));
                            $('#lang_must_not').val(shouldNotArr.join(','));
                        }

                        function applyLanguageState($btn, state) {
                            // state: 0 neutral, 1 success (green), -1 danger (red)
                            $btn.data('state', state);
                            $btn.attr('data-state', state);
                            $btn.removeClass('btn-light btn-success btn-danger');
                            if (state === 0) {
                                $btn.addClass('btn-light');
                            } else if (state === 1) {
                                $btn.addClass('btn-success');
                            } else if (state === -1) {
                                $btn.addClass('btn-danger');
                            }
                        }

                        $(function(){
                            // Initialize: all buttons neutral
                            $('.lang-toggle').each(function(){
                                applyLanguageState($(this), 0);
                            });

                            // Click handler: cycle through states 0 -> 1 -> -1 -> 0
                            $(document).on('click', '.lang-toggle', function(e){
                                e.preventDefault();
                                var $btn = $(this);
                                var state = Number($btn.data('state')) || 0;
                                var next = state === 0 ? 1 : state === 1 ? -1 : 0;
                                applyLanguageState($btn, next);
                                updateLanguageHiddenInputs();
                            });

                            // Update on init
                            updateLanguageHiddenInputs();
                        });
                    })(jQuery);
                </script>
              
                {# Button group for types: cycles neutral -> success -> danger -> neutral #}
                <div class="form-group row">
                    <label class="col-sm-4 control-label">Típusok</label>
                    <div class="col-sm-8">
                        {# Dynamic rites and masstypes loops - generated from mass-definitions.json #}
                        {% for rite in rites %}
                            <div class="btn-group{% if not loop.first %} mt-2{% endif %}" role="group" aria-label="Type filters for {{ rite.key }}" id="type_{{ rite.key }}_Group" data-rite="{{ rite.key }}">
                                {{ macros.type_button(rite.key, true) }}
                                {% for masstype in rite.masstypes %}
                                    {{ macros.type_button(masstype) }}
                                {% endfor %}
                            </div>
                        {% endfor %}
                                                
                        {# Per-rite hidden flags: .should (green) and .must_not (red) Comma-separated lists. #}
                        {# Dynamically generated from rites array #}
                        {% for rite in rites %}
                            <input type="hidden" name="types[{{ rite.key }}][should]" id="types_{{ rite.key }}_should" value="">
                            <input type="hidden" name="types[{{ rite.key }}][must_not]" id="types_{{ rite.key }}_must_not" value="">
                        {% endfor %}

                        {# Aggregate rites inputs: which rites are 'should' (green) and 'must_not' (red) #}
                        <input type="hidden" name="rites[should]" id="rites_should" value="">
                        <input type="hidden" name="rites[must_not]" id="rites_must_not" value="">
                    </div>
                </div>
                {# #644: a templom adottságai — akadálymentesség és gluténmentes áldozás. #}
                <div class="form-group row">
                    <label class="col-sm-4 control-label">Adottságok</label>
                    <div class="col-sm-8">
                        <div class="btn-group" role="group" aria-label="Adottság szűrők" style="display:flex; flex-wrap:wrap; gap:4px;">
                            {# Körbekattintható: semleges -> akadálymentes -> részben akadálymentes -> semleges.
                               A "nem akadálymentes" SZÁNDÉKOSAN nincs benne: arra nincs értelme keresni. #}
                            <button type="button" class="btn btn-light facility-toggle" id="wheelchair_toggle"
                                    data-state="0" title="Kerekesszékkel hozzáférhető" style="padding:6px 10px">
                                <i class="{{ ICONS_WHEELCHAIR }}"></i>
                                <span class="facility-label"></span>
                            </button>

                            {# A hétköznap és a vasárnap külön kérdés — külön gomb mindkettőre. #}
                            <button type="button" class="btn btn-light facility-toggle gluten-toggle"
                                    data-day="holidays" data-state="0"
                                    title="Csökkentett gluténtartalmú áldozás ünnepnapokon" style="padding:6px 10px">
                                <i class="{{ ICONS_GLUTENFREE }}"></i> ünnep
                            </button>
                            <button type="button" class="btn btn-light facility-toggle gluten-toggle"
                                    data-day="weekdays" data-state="0"
                                    title="Csökkentett gluténtartalmú áldozás hétköznapokon" style="padding:6px 10px">
                                <i class="{{ ICONS_GLUTENFREE }}"></i> hétköznap
                            </button>
                        </div>

                        <input type="hidden" name="wheelchair" id="wheelchair_list" value="">
                        <input type="hidden" name="gluten_free" id="gluten_free_list" value="">
                    </div>
                </div>

                <script>
                    (function($){
                        // #644: a kerekesszék-gomb három állapotú. 0 = nincs szűrés (semleges),
                        // 1 = csak akadálymentes (zöld), 2 = a részben akadálymentes is jó (sárga).
                        var WHEELCHAIR_STATES = [
                            { value: '',            css: 'btn-light',   label: '' },
                            { value: 'yes',         css: 'btn-success', label: 'akadálymentes' },
                            { value: 'yes,limited', css: 'btn-warning', label: 'részben is jó' }
                        ];

                        function applyWheelchair(state) {
                            var $btn = $('#wheelchair_toggle');
                            var conf = WHEELCHAIR_STATES[state];
                            $btn.data('state', state).attr('data-state', state);
                            $btn.removeClass('btn-light btn-success btn-warning').addClass(conf.css);
                            $btn.find('.facility-label').text(conf.label ? ' ' + conf.label : '');
                            $('#wheelchair_list').val(conf.value);
                        }

                        function updateGlutenFree() {
                            var days = [];
                            $('.gluten-toggle').each(function(){
                                if (Number($(this).data('state')) === 1) { days.push($(this).data('day')); }
                            });
                            $('#gluten_free_list').val(days.join(','));
                        }

                        $(function(){
                            applyWheelchair(0);
                            updateGlutenFree();

                            $(document).on('click', '#wheelchair_toggle', function(e){
                                e.preventDefault();
                                var next = (Number($(this).data('state')) + 1) % WHEELCHAIR_STATES.length;
                                applyWheelchair(next);
                            });

                            $(document).on('click', '.gluten-toggle', function(e){
                                e.preventDefault();
                                var $btn = $(this);
                                var next = (Number($btn.data('state')) + 1) % 2;
                                $btn.data('state', next).attr('data-state', next);
                                $btn.removeClass('btn-light btn-success').addClass(next ? 'btn-success' : 'btn-light');
                                updateGlutenFree();
                            });
                        });
                    })(jQuery);
                </script>

                {# Button group for categories: simple toggle between neutral and green #}
                <div class="form-group row">
                    <label class="col-sm-4 control-label">Kategóriák</label>
                    <div class="col-sm-8">
                        {# Dynamic categories loop - generated from mass-definitions.json #}
                        <div class="btn-group" role="group" aria-label="Category filters" id="category_group" style="display: flex; flex-wrap: wrap;">
                            {% for category in categories %}
                                <button type="button" class="btn btn-light category-toggle" data-category="{{ category.key }}" data-state="0" style="padding:6px; margin-right:0px; margin-bottom:4px">
                                    {{ ("MASS_TITLE_CATEGORY." ~ category.key)|trans }}
                                </button>
                            {% endfor %}
                        </div>
                                                        
                        {# Single input for selected categories #}
                        <input type="hidden" name="categories" id="categories_list" value="">
                    </div>
                </div>

                <script>
                    (function($){
                        function updateCategoriesList() {
                            // Collect all green (state 1) categories
                            var selectedCategories = [];
                            $('.category-toggle').each(function(){
                                var state = Number($(this).data('state')) || 0;
                                if (state === 1) {
                                    selectedCategories.push($(this).data('category'));
                                }
                            });
                            
                            // Update the hidden input with comma-separated list
                            $('#categories_list').val(selectedCategories.join(','));
                        }
        
                        function applyCategoryState($btn, state) {
                            // state: 0 neutral, 1 success (green)
                            $btn.data('state', state);
                            $btn.attr('data-state', state);
                            $btn.removeClass('btn-light btn-success');
                            if (state === 0) {
                                $btn.addClass('btn-light');
                            } else if (state === 1) {
                                $btn.addClass('btn-success');
                            }
                        }
        
                        $(function(){
                            // Initialize: all buttons neutral
                            $('.category-toggle').each(function(){
                                applyCategoryState($(this), 0);
                            });
        
                            // Click handler: toggle between neutral and green
                            $(document).on('click', '.category-toggle', function(e){
                                e.preventDefault();
                                var $btn = $(this);
                                var state = Number($btn.data('state')) || 0;
                                var next = (state + 1) % 2;
                                applyCategoryState($btn, next);
                                updateCategoriesList();
                            });
        
                            // Update on init
                            updateCategoriesList();
                        });
                    })(jQuery);
                </script>
    
                <script>
                    (function($){
                        function updateHiddenInputs() {
                            
                            // Dynamically iterate through all rites and collect their type states
                            $('.btn-group[data-rite]').each(function(){
                                var $group = $(this);
                                var rite = $group.data('rite');
                                var shouldArr = [];
                                var mustNotArr = [];
                                
                                // Collect states from non-special buttons in this rite group
                                $group.find('.type-toggle').not('.special-toggle').each(function(){
                                    var s = Number($(this).data('state')) || 0;
                                    var t = $(this).data('type');
                                    if (s === 1) shouldArr.push(t);
                                    else if (s === 2) mustNotArr.push(t);
                                });
                                
                                // Update the hidden inputs for this rite
                                $('#types_' + rite + '_should').val(shouldArr.join(','));
                                $('#types_' + rite + '_must_not').val(mustNotArr.join(','));
                            });
                            
                            // Update aggregated rites inputs based on special buttons
                            var ritesShould = [];
                            var ritesMustNot = [];
                            $('.special-toggle').each(function(){
                                var s = Number($(this).data('state')) || 0;
                                var t = $(this).data('type');
                                if (s === 1) ritesShould.push(t);
                                else if (s === 2) ritesMustNot.push(t);
                            });
                            $('#rites_should').val(ritesShould.join(','));
                            $('#rites_must_not').val(ritesMustNot.join(','));
                        }

                        function applyState($btn, state) {
                            // state: 0 neutral, 1 success, 2 danger
                            // For special buttons, force only 1 or 2 (no neutral)
                            if ($btn.hasClass('special-toggle') && state === 0) {
                                state = 1;
                            }
                            $btn.data('state', state);
                            $btn.prop('disabled', false);
                            $btn.removeClass('btn-light btn-success btn-danger');
                            if (state === 0) {
                                $btn.addClass('btn-light');
                            } else if (state === 1) {
                                $btn.addClass('btn-success');
                            } else if (state === 2) {
                                $btn.addClass('btn-danger');
                            }
                        }

                        // Update only the special button's own group when its state changes.
                        function updateSpecialGroup($special) {
                            var state = Number($special.data('state')) || 0;
                            var $group = $special.closest('.btn-group');
                            if (state === 2) {
                                // mark group invalid: disable other buttons in this same group
                                $group.addClass('invalid-row');
                                $group.find('.type-toggle').not($special).each(function(){
                                    $(this).prop('disabled', true);
                                    $(this).addClass('disabled');
                                });
                            } else {
                                // valid: enable other buttons in this group
                                $group.removeClass('invalid-row');
                                $group.find('.type-toggle').not($special).each(function(){
                                    $(this).prop('disabled', false);
                                    $(this).removeClass('disabled');
                                });
                            }
                        }
 
                        $(function(){
                            // initialize from any existing hidden inputs (e.g., preserved values)
                            var initMust = ($('#types_must').val() || '').toString().split(',').filter(Boolean);
                            var initMustNot = ($('#types_must_not').val() || '').toString().split(',').filter(Boolean);
                            $('.type-toggle').each(function(){
                                var $btn = $(this);
                                var type = $btn.data('type');
                                if (initMust.indexOf(type) !== -1) applyState($btn, 1);
                                else if (initMustNot.indexOf(type) !== -1) applyState($btn, 2);
                                else {
                                    // If no hidden inputs provided, default special buttons to green, others neutral
                                    if ($btn.hasClass('special-toggle')) {
                                        applyState($btn, 1);
                                    } else {
                                        applyState($btn, 0);
                                    }
                                }
                            });

                            // Ensure specials never remain neutral: convert any special with state 0 to 1
                            $('.special-toggle').each(function(){
                                var $s = $(this);
                                if (Number($s.data('state')) === 0) {
                                    applyState($s, 1);
                                }
                                updateSpecialGroup($s);
                            });

                            // click behavior
                            $(document).on('click', '.type-toggle', function(e){
                                // prevent clicks on disabled buttons
                                if ($(this).prop('disabled')) return;
                                e.preventDefault();
                                var $btn = $(this);
                                var state = Number($btn.data('state')) || 0;

                                if ($btn.hasClass('special-toggle')) {
                                    // toggle between green (1) and red (2) only
                                    var next = (state === 1) ? 2 : 1;
                                    applyState($btn, next);
                                    updateSpecialGroup($btn);
                                } else {
                                    // regular buttons cycle: 0 -> 1 -> 2 -> 0
                                    var next = (state + 1) % 3;
                                    applyState($btn, next);
                                }

                                updateHiddenInputs();
                            });

                            // update hidden inputs on init
                            updateHiddenInputs();
                        });
                    })(jQuery);
                </script>


            </div>

            <div class="home-cta-buttons form-group" style="margin-top:12px">
                <button type=submit name="q" value="SearchResultsMasses"  class="btn btn-primary" id="search_masses_btn"></button>
                <button type=submit name="q" value="SearchResultsChurches"  class="btn btn-primary">Templom keresése</button>
            </div>
            
            <script>
                (function($){
                    function updateMassesButtonText() {
                        // Count selected categories (state === 1)
                        var selectedCategories = [];
                        $('.category-toggle').each(function(){
                            var state = Number($(this).data('state')) || 0;
                            if (state === 1) {
                                selectedCategories.push({
                                    key: $(this).data('category'),
                                    text: $(this).text().trim()
                                });
                            }
                        });
                        
                        var $btn = $('#search_masses_btn');
                        if (selectedCategories.length === 1) {
                            // Show the category name with "keresése"
                            $btn.text(selectedCategories[0].text + ' keresése');
                        } else {
                            // Default text
                            $btn.text('Események keresése');
                        }
                    }
                    
                    // Update on category button clicks
                    $(document).on('click', '.category-toggle', function(){
                        setTimeout(function(){
                            updateMassesButtonText();
                        }, 0);
                    });
                    
                    // Update on init
                    $(function(){
                        updateMassesButtonText();
                    });
                })(jQuery);
            </script>

        </form>
    </div>
	
