{% extends 'panel.twig' %}
{% import "forms.twig" as forms %}
{% set title = 'Új keresés' %}
{% set panel = 'primary' %}

{% block body %}
    <form method=get id="panel-search-church-form">
        <input type=hidden name=q value=SearchResultsChurches>
        <input type=hidden id=keresestipus name=keresestipus value=0>
        {# #722: a hely szerinti szűrés eddig elveszett, ha a sidebarból indult új keresés
           — a mise-panelnek (_panelsearchmass.twig) volt ilyenje, a templom-panelnek nem. #}
        {% if nearbyOrigin is defined and nearbyOrigin %}
            <input type=hidden name=nearby_lat value="{{ nearbyOrigin.lat }}">
            <input type=hidden name=nearby_lon value="{{ nearbyOrigin.lon }}">
            <input type=hidden name=nearby_radius value="{{ nearbyRadius }}">
        {% elseif form.hely is defined and form.hely.value %}
            <input type=hidden name=hely value="{{ form.hely.value }}">
            <input type=hidden name=tavolsag value="{{ form.tavolsag.value|default(0) }}">
        {% endif %}
        <style>
            #panel-search-form > .row{
                margin-bottom:10px;
            }
        </style>
        <div id="panel-search-form" style="padding-right:10px;padding-left:10px">
            <div class="row">
                <input type=text name=kulcsszo id='keyword' size=20 class="keresourlap form-control" value="{{ form.kulcsszo.value }}">                
            </div>
            <div class="row">
                <input type=submit value="keresés" class="keresourlap form-control">
            </div>
        </div>
    </form>
    <script>
    (function() {
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize UnifiedAutocomplete if available
            if (typeof UnifiedAutocomplete !== 'undefined') {
                UnifiedAutocomplete.init('#keyword', '#panel-search-church-form', {
                    initialBoundaries: window.boundaryDataFromUrl || [],
                    initialChurches: window.churchDataFromUrl || []
                });
            }

            // #356: ha a felhasználó az eredmény-oldalról elnavigál (pl. egy
            // templom-oldalra) és visszatér a keresőre, a beírt kulcsszó
            // maradjon meg a sessionre. Ha az inputot a PHP backend már
            // megtöltötte (eredmény-oldal sidebarja), azt nem írjuk felül.
            try {
                var keyInput = document.getElementById('keyword');
                var form = document.getElementById('panel-search-church-form');
                if (!keyInput || !form) return;

                if (!keyInput.value) {
                    var stored = sessionStorage.getItem('miserend.lastSearchKulcsszo');
                    if (stored) {
                        keyInput.value = stored;
                    }
                }

                form.addEventListener('submit', function () {
                    try { sessionStorage.setItem('miserend.lastSearchKulcsszo', keyInput.value || ''); } catch (_) {}
                });
            } catch (_) {
                // sessionStorage privát/inkognitó-módban dobhat - csendben nyeljük el.
            }
        });
    })();
    </script>
    <script>
        // Inject boundary data from PHP backend           
        window.boundaryDataFromUrl = {{ boundaryDataJson ? boundaryDataJson|raw : '[]' }};
	</script>
{% endblock %}
