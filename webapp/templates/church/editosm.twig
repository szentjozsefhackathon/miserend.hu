{% extends "layout.twig" %}

{% import "forms.twig" as forms %}

{% set columns2 = true  %}

{# Provide church metadata for mobile header #}
{% set id = church.id %}
{% set alternative_names = church.alternative_names %}

{% block pageHeader %}
    <div class="page-header">
        <h2>
            OSM szerkesztése: {{ church.names.0 }}
        </h2>
        
        {# Alternative names - Desktop only #}
        {% if church.alternative_names|length > 0 %}
            <div class="page-header-alt-names-desktop">
                <small>
                    <span class="hidden-xs hidden-sm">
                       {{ church.alternative_names.0|raw }}{% if church.alternative_names|length > 1 %}, <a href="#" onclick="this.style.display='none'; document.getElementById('all-names-desk').style.display='inline'; return false;">...</a><span id="all-names-desk" style="display:none;" onclick="document.getElementById('all-names-desk').style.display='none'; this.previousElementSibling.style.display='inline'; return false;">
                            {{ church.alternative_names|slice(1)|join(", ")|raw }}
                        </span>
                    {% endif %}
                    </span>
                </small>
            </div>
        {% endif %}
    </div>
{%  endblock %}

{% block content %}

	{# Admin links section #}
	{% set writeAcess = true %}
	{% include 'church/_adminlinks-section.twig' %}

	<div class="alert alert-info">Misézőhelyeink össze vannak kötve a nyilvános OpenStreetMap adatbázissal. Ezen az oldalon az ebben az adatbázisban fellelhető adatokat kezelhetjük és módosíthatjuk.</div>
	
	<div class="alert alert-warning">Az alábbi adatok közül honlapunkon még még nem használ fel minden adatot.</div>
	
    <FORM ENCTYPE='multipart/form-data' method=post>
    {{ csrf_field() }}
        <input type=hidden name=church[id] value={{ church.id }}>
		<input type=hidden name=osmid value={{ church.osmid }}>
		<input type=hidden name=osmtype value={{ church.osmtype }}>
		
			
		
      		
		{% for id, section in form %}	

			<h4 id="{{ id }}">{{ section.title }}</h4>
			{% if block("section_" ~ id) is defined %}
				{{ block( "section_" ~ id )|raw }}
			{% else %}
				<p>{{ section.description|raw }}</p>
			{% endif %}
			
			
			<table class="table table-hover table-condensed table-striped" >			
			<tbody>
			{% for key, item in section.inputs %}
				<tr class="{{ item['highlighted'] is defined and item['highlighted'] ? 'table-warning' : '' }}">
					<td class="align-middle col-md-3" align="right" >
						{{ item['title'] }}:<br/>
						<small><a href="https://wiki.openstreetmap.org/wiki/{% if item['wiki_hu'] %}HU:{% endif %}Key:{{ item['id'] }}" target="_blank">{{ item['id'] }}</a></small>
					</td>
					<td >
						{% if item['type'] == 'input' %}
							{{ forms.input(item) }}
							{% if item.disabled %}<input type="hidden" name="{{ item.name }}" value="{{ item.value|e }}">{% endif %}
						{% elseif item['type'] == 'textarea' %}
							{{ forms.textarea(item) }}
						{% else %}
						 juj
						 
						{% endif %}
					</td>
					<td>
						{% if item.help %}{{ _self.helplink(key|replace({':': '_'}), ICONS_INFO ) }}{% endif %}
						<small title="Ez a mező {{ item.occurrences }} misézőhelyen van kitöltve">{{ item.occurrences }}</small>
					</td>
				</tr>
				{% if item.help %}{{ _self.helptr(key|replace({':': '_'}),item.help) }}{% endif %}
			{% endfor %}
			</tbody>
			</table>
			
		{% endfor %}
						
            <tr>
			
                <td>
                    <div align=right><input type=submit name='submit' value=Mehet class=urlap>&nbsp;</div>
                </td>
                <td>					
                    <input type=radio name=modosit value=i class=urlap checked><span class=alap> és újra módosít</span><br/>
                    <input type=radio name=modosit value=m class=urlap><span class=alap> és tovább a miserendre</span><br/>
                    <input type=radio name=modosit value=n class=urlap><span class=alap> és vissza a listába</span><br/>
                    <input type=radio name=modosit value=t class=urlap><span class=alap> és vissza a templom oldalára</span>
                </td>
                <td></td>
            </tr>
        </table>
    </form>                
    
	<div class="alert alert-info">Részletesebb adatszerkesztési lehetőségekért lépj be valamelyik OSM szerkesztőbe saját névvel és ottan tedd, mit tenni akarsz.</div>
    
    <script>
  $( function() {
		    	
   
    $( ".info" ).on( "click", function() {         
               $('#help' + $( this ).data('id') ).toggle(600);
    });
 
    $( ".church-link-add" ).on( "click", function() {
      newLinkDialog.dialog( "open" );
    });
    
   
  } );
  </script>
  

  <style>
   .autocomplete-button {
            margin-left: 5px;
            cursor: pointer;
            display: inline-block;
            width: 20px;
            height: 20px;
            text-align: center;
            line-height: 20px;
            background-color: #ddd;
            border-radius: 5px;
        }
 </style>
	
 <script>
 $(document).ready(function(){
  	
	var options = {
	 {% for id, section in form %}
      {% for key, item in section.inputs %}
		{% if item.options %}
			"{{ key }}" :  
				{{ item.options|json_encode(constant('JSON_PRETTY_PRINT') b-and constant('JSON_NUMERIC_CHECK') )|raw }} ,
        {% endif %}        
      {% endfor %}
    {% endfor %}
	};
 
	
	$(".form-control").each(function(){
		var id = $(this).attr('id');
		
		if(options[id]) {
			$(this)
				
				.autocomplete({
					delay: 0,
					minLength: 0,
					source: options[id],
					select: function(event, ui) {
						// Ha a mező disabled, ne töltse ki az értéket
						if ($(this).prop('disabled')) {
							event.preventDefault();
							return false;
						}
					}
				});
				
			// Add button after the input
			var button = $('<a class="autocomplete-button">&#9660;</a>');
			$(this).closest('td').next("td").prepend(button);

			// Attach click event to the button
			
			
			button.click(function() {
	                   // Trigger the autocomplete search - mindig nyissa ki a legördülőt
					$('#' + id.replace(/:/g, '\\:') ).autocomplete("search", "");
	               });
			
			
			
			
		}
	});
 
 
 } );
 </script>
  

{% endblock %}

{% block section_religious_administration %}
	<p>A misézőhely egyházigazgatási területi beosztását megpróbáljuk térkép alapján beállítani. Az alábbi részekhez így csak akkor kell hozzányúlni, hogy ha nem sikerült megtalálnunk az egyházmegyét, espereskerületet, plébániát. Vagy ha valamiért nem a területileg illetékes egyházmegyéhez/espereskerülethez tartozik a misézőhely például a Katonai Ordinariátus egyféle enklévájaként.</p>
	<div class="card">
		<div class="card-body">
			{% if administration[ osmtags.denomination ~ '_administration']|length > 0 %}				
				A következő területi beosztást találtunk meg:
				<ul>
				{% for adm in administration[ osmtags.denomination ~ '_administration'] %}
					<li>
					<a href="/collection/{{ adm.osm.type }}:{{ adm.osm.id }}"><strong>{{ adm.name }}</strong></a> <span class="badge" style="background-color: {{ adm.color }};">{{ adm.type }}</span></li>
				{% endfor %}
				</ul>
			{% else %}
				Területi elhelyezkedés alapján nem találtunk adatot
			{% endif %}
		</div>
	</div><br/>
{% endblock %}


{% block section_location %}
	<p>Itt kifejezetten a templomnak az adataira vagyunk kíváncsiak (és nem pl. a helyi plébániáéra).</p>
	<div class="card">
		<div class="card-body">
			{% if administration[ 'administration']|length > 0 %}				
				A területi elhelyezkedése alapján azért megtaláltunk már így is némi információt:
				<ul>
				{% for adm in administration[ 'administration'] %}
					<li><a href="/collection/{{ adm.osm.type }}:{{ adm.osm.id }}"><strong>{{ adm['name:hu'] ?? adm.name }}</strong></a> <span class="badge" style="background-color: {{ adm.color }};">{{ adm.type }}</span></li>
				{% endfor %}
				</ul>
			{% else %}
				Területi elhelyezkedés alapján nem találtunk adatot
			{% endif %}
		</div>
	</div><br/>

{% endblock %}


{% block rightsidebar %}    
{% endblock %}

{% macro helplink(id, icon) %}
    <span title="Súgó" class="grey {{ icon }} info" aria-hidden="true" data-id="{{ id }}"></span>
{% endmacro %}

{% macro helptr(id, help) %}
    <tr style="display:none" id="help{{ id }}"><td colspan="3"><i>{{ help|raw }}</i></td></tr>
	<tr style="display:none" ></tr>
{% endmacro %}
